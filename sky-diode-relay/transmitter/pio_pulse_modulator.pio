;
; File: sky-diode-relay/transmitter/pio_pulse_modulator.pio
; Description: RP2040 PIO Microsecond Pulse-Position Modulation (PPM) Driver
; License: MIT
;
; Generates sub-microsecond optical pulse bursts with zero CPU interrupt jitter.
; Operates at 100 MHz clock (10 ns per instruction cycle).
;
.program pio_pulse_modulator

; Pull 32-bit word from FIFO containing:
;   - Lower 16 bits (X): Inter-pulse pre-delay loop count (100 ns per step @ 100 MHz)
;   - Upper 16 bits (Y): Optical pulse high width loop count (10 ns per step @ 100 MHz)
; Fail-safe invariant: Output pin is driven LOW before waiting on TX FIFO so an empty
; FIFO or stalled host CPU can never leave the GaN laser/UVC driver energized.
.wrap_target
entry:
    set pins, 0                 ; Fail-safe: guarantee driver OFF while waiting for FIFO
    pull block                  ; Wait for next 32-bit PPM timing word from TX FIFO
    out x, 16                   ; Lower 16 bits = Inter-pulse delay count (in 100ns steps)
    out y, 16                   ; Upper 16 bits = Optical pulse width count (in 10ns steps)

    jmp !x pulse_guard          ; If delay count is 0, skip delay loop
slot_delay_loop:
    jmp x-- slot_delay_loop [9] ; 10 cycles per iteration (100 ns @ 100 MHz)

pulse_guard:
    jmp !y entry                ; Safety guard: if pulse width is 0, never assert pin HIGH

pulse_high:
    set pins, 1                 ; Turn ON GaN driver (1550nm Laser / 265nm UVC LED ON)
pulse_width_loop:
    jmp y-- pulse_width_loop    ; High pulse duration (10 ns resolution per count)

pulse_low:
    set pins, 0                 ; Turn OFF GaN driver immediately
.wrap

