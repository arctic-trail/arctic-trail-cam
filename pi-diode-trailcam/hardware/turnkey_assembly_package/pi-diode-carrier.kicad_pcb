(kicad_pcb (version 20221018) (generator pcbnew)

  (general
    (thickness 1.6)
  )

  (paper "A4")

  (title_block
    (title "pi-diode-trailcam RP2040 Arctic Carrier PCB")
    (date "2026-10-14")
    (rev "v2.0-Arctic")
    (company "Open-Source Off-Grid Boreal Sensor Group")
    (comment 1 "4-Layer Stackup: F.Cu (Signals), In1.Cu (GND Plane), In2.Cu (12V/5V Power), B.Cu (Signals/GND)")
    (comment 2 "Dimensions: 100mm x 80mm with 4x M3 Mounting Holes matching Fibox ARCA backplate")
  )

  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" power "GND")
    (2 "In2.Cu" power "PWR")
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )

  (setup
    (pad_to_mask_clearance 0.05)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros false)
      (usegerberextensions false)
      (usegerberattributes true)
      (usegerberadvancedattributes true)
      (creategerberjobfile true)
      (svgprecision 4)
      (plotframeref false)
      (viasonmask false)
      (mode 1)
      (useauxorigin false)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (pdf_front_fp_property_popups true)
      (pdf_back_fp_property_popups true)
      (dxfopts 0)
      (psnegative false)
      (psa4output false)
      (plotreference true)
      (plotvalue true)
      (plotinvisibletext false)
      (sketchpadsonfab false)
      (subtractmaskfromsilk false)
      (outputformat 1)
      (mirror false)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "")
    )
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "+12V_BATT")
  (net 3 "+3V3_ALWAYS_ON")
  (net 4 "+12V_SWITCHED")
  (net 5 "+5V_PI5")
  (net 6 "GP15_MOSFET_GATE")
  (net 7 "GP16_DEICE_GATE")
  (net 8 "GP17_PI5_DONE")
  (net 9 "I2C0_SDA")
  (net 10 "I2C0_SCL")
  (net 11 "UART0_RADAR_TX")
  (net 12 "UART0_RADAR_RX")
  (net 13 "UART1_TELEMETRY_TX")

  ;; PCB Board Outline: 100mm x 80mm
  (gr_line (start 0 0) (end 100 0) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 100 0) (end 100 80) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 100 80) (end 0 80) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 0 80) (end 0 0) (layer "Edge.Cuts") (width 0.15))

  ;; 4x M3 Mounting Holes (offset 4mm from corners: 92mm x 72mm pitch)
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad" (layer "F.Cu")
    (at 4 4)
    (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers *.Cu *.Mask) (net 1 "GND"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad" (layer "F.Cu")
    (at 96 4)
    (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers *.Cu *.Mask) (net 1 "GND"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad" (layer "F.Cu")
    (at 96 76)
    (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers *.Cu *.Mask) (net 1 "GND"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad" (layer "F.Cu")
    (at 4 76)
    (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers *.Cu *.Mask) (net 1 "GND"))
  )

  ;; Silkscreen Text
  (gr_text "PI-DIODE ARCTIC CARRIER v2.0" (at 50 8) (layer "F.SilkS")
    (effects (font (size 2 2) (thickness 0.3) (bold true)))
  )
  (gr_text "FIBOX ARCA 3020 COMPATIBLE" (at 50 12) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.2)))
  )
  (gr_text "12V BATT IN" (at 12 18) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (gr_text "DOMAIN B: 0.00W STANDBY" (at 50 72) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.2)))
  )
)
